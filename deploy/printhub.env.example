# /etc/printhub/printhub.env — Print Hub service configuration.
# Changes take effect after: sudo systemctl restart printhub
# See docs/CONFIGURATION.md for every option.

# production = real CUPS printers only. demo = simulated printers only (never both).
PRINTHUB_MODE=production

PRINTHUB_DATA_DIR=/var/lib/printhub
PRINTHUB_LOG_DIR=/var/log/printhub
PRINTHUB_STATIC_DIR=/opt/printhub/current/frontend/dist

# Listen on the office network. Restrict with the firewall (docs/OPERATIONS.md › Network).
PRINTHUB_HOST=0.0.0.0
PRINTHUB_PORT=8080

# Upload and processing limits
PRINTHUB_MAX_FILE_MB=50
PRINTHUB_MAX_FILES_PER_JOB=20
PRINTHUB_MAX_PDF_PAGES=500

# Sessions. Set SECURE_COOKIES=true only when serving over HTTPS.
PRINTHUB_SESSION_HOURS=12
PRINTHUB_SECURE_COOKIES=false

# CUPS (defaults use the local scheduler's Unix socket)
#PRINTHUB_CUPS_SOCKET=/run/cups/cups.sock
PRINTHUB_SERVICE_USER=printhub

# A queued job that hasn't started after this many minutes is flagged in diagnostics.
PRINTHUB_STUCK_JOB_MINUTES=20

# Log rotation for /var/log/printhub/printhub.jsonl
PRINTHUB_LOG_MAX_BYTES=5242880
PRINTHUB_LOG_BACKUPS=5
